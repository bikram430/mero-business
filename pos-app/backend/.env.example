# Copy this to .env and fill in real values
# NEVER commit .env to git

# --- Database ---
DATABASE_URL=postgresql://mero_user:your_password@localhost:5432/mero_business

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Environment ("development" shows dev_otp in responses; "production" hides it)
ENVIRONMENT=development

# --- JWT (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_me_to_a_long_random_string

# --- eSewa (apply at esewa.com.np/merchant)
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=

# --- Fonepay (apply at fonepay.com)
FONEPAY_MERCHANT_CODE=
FONEPAY_SECRET_KEY=

# --- Sparrow SMS (sparrowsms.com — Nepal-based, cheapest)
SPARROW_SMS_TOKEN=
SPARROW_SMS_SENDER=MeroBiz

# --- WhatsApp (Twilio or 360dialog)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# --- Cloudflare R2 (receipt PDF storage)
CF_R2_BUCKET=mero-business-receipts
CF_R2_ACCESS_KEY=
CF_R2_SECRET_KEY=
CF_R2_ENDPOINT=

# --- CORS (comma-separated list of allowed origins)
# ALLOWED_ORIGINS=["https://merchant.merobusiness.com.np"]
